{{!-- Older/newer post links. Context: post. Neighbours are looked up with a
      filter so posts tagged #photos (their own section) are skipped; the nav
      hides itself via CSS when empty. published_at is compared in UTC. --}}
<nav class="gh-post-nav gh-container-wide" aria-label="{{t "More posts"}}">
    {{#get "posts" filter=(concat "published_at:<'" (date published_at format="YYYY-MM-DD HH:mm:ss" timezone="Etc/UTC") "'+id:-" id "+tag:-hash-photos" separator="") order="published_at desc" limit="1" as |older|}}
        {{#foreach older}}
            <a class="gh-post-nav-link gh-post-nav-link--prev" href="{{url}}" rel="prev">
                <span class="gh-post-nav-kicker">{{t "Previous post"}}</span>
                <span class="gh-post-nav-title">{{title}}</span>
            </a>
        {{/foreach}}
    {{/get}}
    {{#get "posts" filter=(concat "published_at:>'" (date published_at format="YYYY-MM-DD HH:mm:ss" timezone="Etc/UTC") "'+id:-" id "+tag:-hash-photos" separator="") order="published_at asc" limit="1" as |newer|}}
        {{#foreach newer}}
            <a class="gh-post-nav-link gh-post-nav-link--next" href="{{url}}" rel="next">
                <span class="gh-post-nav-kicker">{{t "Next post"}}</span>
                <span class="gh-post-nav-title">{{title}}</span>
            </a>
        {{/foreach}}
    {{/get}}
</nav>
