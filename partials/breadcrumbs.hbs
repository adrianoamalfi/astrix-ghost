<nav class="gh-breadcrumbs" aria-label="{{t "Breadcrumbs"}}">
    <a href="{{@site.url}}">{{t "Home"}}</a>
    {{#is "post"}}
        {{#primary_tag}}
            <span aria-hidden="true">/</span>
            <a href="{{url}}">{{name}}</a>
        {{/primary_tag}}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{title}}</span>
    {{/is}}
    {{#is "tag"}}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{name}}</span>
    {{/is}}
    {{#is "author"}}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{name}}</span>
    {{/is}}
    {{#is "page"}}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{title}}</span>
    {{/is}}
</nav>
{{!-- BreadcrumbList structured data for Google rich results. Each branch keeps
      comma placement explicit so the emitted JSON stays valid with or without
      a primary tag. --}}
{{#is "post"}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "{{t "Home"}}",
            "item": "{{@site.url}}"
        }{{#primary_tag}},
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{name}}",
            "item": "{{url absolute="true"}}"
        }{{/primary_tag}},
        {
            "@type": "ListItem",
            "position": {{#primary_tag}}3{{else}}2{{/primary_tag}},
            "name": "{{title}}",
            "item": "{{url absolute="true"}}"
        }
    ]
}
</script>
{{/is}}
{{#is "page"}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "{{t "Home"}}",
            "item": "{{@site.url}}"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{title}}",
            "item": "{{url absolute="true"}}"
        }
    ]
}
</script>
{{/is}}
