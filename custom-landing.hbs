{{!< default}}

{{!-- Landing template: assign "Landing" to any page in Ghost admin. Renders
      the page content built entirely from editor cards, with no title,
      breadcrumbs, or article chrome. Use it for product pages, event
      announcements, or any page that is 100% Koenig cards. --}}

{{#post}}
<main class="gh-landing {{post_class}}">
    <section
        class="gh-content gh-canvas"
        data-table-label="{{t "Scrollable table"}}"
        data-copy="{{t "Copy"}}"
        data-copied="{{t "Copied"}}"
        data-anchor-label="{{t "Copy link to this section"}}"
        data-anchor-copied-label="{{t "Copied"}}"
        data-zoom-label="{{t "Zoom image"}}"
        data-close-label="{{t "Close"}}"
        data-prev-label="{{t "Previous"}}"
        data-next-label="{{t "Next"}}"
    >
        {{content}}
    </section>
</main>
{{/post}}
